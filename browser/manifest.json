{
  "manifest_version": 2,
  "name": "Haruneko helper",
  "version": "1.0",
  "description": "Haruneko helper",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Haruneko Helper",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "haruneko@anen.asa",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
