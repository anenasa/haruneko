{
  "manifest_version": 2,
  "name": "Haruneko helper",
  "version": "1.0",
  "description": "Haruneko helper",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "my-test-addon@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
